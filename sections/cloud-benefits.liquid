{%- comment -%}
  Cloud benefits: a heading and a reflowing row of white cards, each with a
  large tinted icon disc. Disc tints cycle so a four-up row reads as a set.
{%- endcomment -%}

<section class="cloud-benefits">
  <div class="cloud-benefits__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cloud-benefits__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="cloud-benefits__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tints = 'sky,peach,lilac,sky' | split: ','
          assign tint = tints[forloop.index0] | default: 'sky'
        -%}
        <div class="cloud-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="cloud-card__disc cloud-card__disc--{{ tint }}" aria-hidden="true">
              <span class="sr-icon" style="--sr-icon: url({{ block.settings.icon | asset_url }})"></span>
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="cloud-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="cloud-card__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cloud-benefits {
    padding: var(--section-y) 0;
  }

  .cloud-benefits__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
    display: grid;
    gap: clamp(24px, 3vw, 36px);
  }

  .cloud-benefits__heading {
    max-width: 24ch;
    font-size: var(--type-section-size);
    line-height: var(--type-section-line);
    font-weight: var(--weight-bold);
  }

  .cloud-benefits__grid {
    display: grid;
    /* Every card as tall as the tallest in its row, so the set reads evenly
       however the copy wraps. */
    grid-auto-rows: 1fr;
    grid-template-columns: repeat(auto-fit, minmax(min(216px, 100%), 1fr));
    gap: clamp(14px, 2vw, 24px);
  }

  /* Four cards as a 2x2 rather than three across with one stranded below.
     Held back to 480px because these cards carry a paragraph, and half of a
     375px screen leaves it about eleven characters a line. */
  @media screen and (min-width: 480px) and (max-width: 1079px) {
    .cloud-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cloud-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: clamp(24px, 2.6vw, 32px);
    display: grid;
    gap: 16px;
    align-content: start;
    box-shadow: var(--shadow-card);
  }

  .cloud-card__disc {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
  }

  .cloud-card__disc .sr-icon {
    width: 26px;
    height: 26px;
  }

  /* One plate colour across all four cards. Three different tints made the
     grid look like four unrelated things. The modifier classes stay so the
     markup and schema do not have to change. */
  .cloud-card__disc--sky,
  .cloud-card__disc--peach,
  .cloud-card__disc--lilac {
    background: var(--color-accent);
    color: var(--color-secondary);
  }

  .cloud-card__title {
    font-size: var(--type-card-title-size);
    font-weight: var(--weight-bold);
  }

  .cloud-card__text {
    font-size: var(--type-body-sm-size);
    line-height: 1.6;
    color: var(--color-body);
  }

  /* Compact on a phone. At full size these four cards ran 1234px, a screen and
     a half, and 20 per cent of the homepage: more than four times the space
     the products themselves get. Same content, tighter frame. */
  @media screen and (max-width: 560px) {
    .cloud-card {
      padding: 16px;
      gap: 8px;
      border-radius: var(--radius-tile);
    }

    .cloud-card__disc {
      width: 40px;
      height: 40px;
    }

    .cloud-card__disc .sr-icon {
      width: 20px;
      height: 20px;
    }

    .cloud-card__title {
      font-size: 15px;
      line-height: 1.25;
    }

    .cloud-card__text {
      font-size: 13.5px;
      line-height: 1.45;
    }
  }

  /* Icon beside the text, but only while the card has the full width to
     itself. Stacked, each card spent a whole row on the disc before the title
     started. Above 480px the grid is two columns, and beside the icon the copy
     column fell to about 90px, which wrapped every line to three words. */
  @media screen and (max-width: 479px) {
    .cloud-card {
      grid-template-columns: 40px minmax(0, 1fr);
      align-items: center;
      gap: 4px 12px;
    }

    .cloud-card__disc {
      grid-row: span 2;
    }

    .cloud-card__title,
    .cloud-card__text {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cloud benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around the way a shift actually goes" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon filename", "default": "icon-wind.svg" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Material, performance and care claims must be verifiable. Compression is a support level, never a treatment." }
      ]
    }
  ],
  "presets": [
    { "name": "Cloud benefits", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }
  ]
}
{% endschema %}
