{%- comment -%}
  Cloud story: a lilac panel, copy one side, photograph the other, filling the
  panel edge to edge.
{%- endcomment -%}

<section class="cloud-story">
  <div class="cloud-story__panel">
    <div class="cloud-story__copy">
      {%- if section.settings.tag != blank -%}
        <span class="cloud-story__tag">{{ section.settings.tag }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cloud-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="cloud-story__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="cloud-story__cta">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="cloud-story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading, sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        <img src="{{ 'sr-scrubs-duo.webp' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1200" height="900">
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cloud-story {
    padding: clamp(36px, 5vw, 80px) var(--gutter-page);
  }

  .cloud-story__panel {
    max-width: var(--container-page);
    margin: 0 auto;
    background: var(--color-surface);
    border-radius: var(--radius-panel);
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    align-items: center;
  }

  .cloud-story__copy {
    padding: var(--panel-pad);
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .cloud-story__tag {
    height: 36px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.7);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: var(--weight-semibold);
  }

  .cloud-story__heading {
    max-width: 22ch;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.04;
  }

  .cloud-story__text {
    max-width: 44ch;
    font-size: var(--type-body-md-size);
    line-height: 1.68;
    color: var(--color-body-strong);
  }

  .cloud-story__cta {
    height: var(--control-height-lg);
    padding: 0 28px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15.5px;
    font-weight: var(--weight-semibold);
    transition: var(--transition-color);
  }

  .cloud-story__cta:hover {
    background: var(--color-ink);
    color: var(--color-on-dark);
  }

  .cloud-story__media {
    align-self: stretch;
    min-height: 320px;
  }

  .cloud-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 560px) {
    .cloud-story__panel {
      border-radius: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cloud story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Soft Rounds Australia" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, falls back to bundled photo)" }
  ],
  "presets": [{ "name": "Cloud story" }]
}
{% endschema %}
