{%- comment -%}
  Direction C newsletter: a single white card on the ivory page. Uses Shopify's
  native customer form, so successful sign-ups land in the store's customer list
  with the "newsletter" tag — no third-party app needed.

  Field states (default / focus / error / success) are specified in the design;
  focus and error are wired to the real form state below.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="newsletter-c section-{{ section.id }}-padding">
  <div class="sr-container">
    <div class="newsletter-c__card">
      <div class="newsletter-c__inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter-c__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="newsletter-c__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'newsletter-c-form', class: 'newsletter-c__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-c__success" role="status">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
              {{ section.settings.success_text }}
            </p>
          {%- else -%}
            <label class="newsletter-c__label" for="NewsletterEmail-{{ section.id }}">
              {{ section.settings.label }}
            </label>
            <div class="newsletter-c__row">
              <input
                id="NewsletterEmail-{{ section.id }}"
                class="newsletter-c__input{% if form.errors %} newsletter-c__input--error{% endif %}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.placeholder }}"
                required
                {%- if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NewsletterError-{{ section.id }}"
                {%- endif %}
              >
              <button type="submit" class="sr-btn sr-btn--primary newsletter-c__submit">
                {{ section.settings.button_label }}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="newsletter-c__error" id="NewsletterError-{{ section.id }}" role="alert">
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}

            {%- if section.settings.disclaimer != blank -%}
              <p class="newsletter-c__disclaimer">{{ section.settings.disclaimer }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter-c__card {
    background: var(--surface-card);
    border-radius: var(--radius-card);
    padding: 56px;
    box-shadow: var(--shadow-soft);
    text-align: center;
  }

  .newsletter-c__inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .newsletter-c__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-display-md-size);
    font-weight: var(--type-display-md-weight);
    line-height: var(--type-display-md-line);
    letter-spacing: var(--type-display-md-tracking);
    color: var(--color-ink);
  }

  .newsletter-c__text {
    margin: 12px 0 0;
    font-family: var(--font-sans);
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .newsletter-c__form {
    margin: 28px 0 0;
    text-align: left;
  }

  .newsletter-c__label {
    display: block;
    margin: 0 0 8px;
    font-family: var(--font-sans);
    font-size: var(--type-caption-size);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--text-muted);
  }

  .newsletter-c__row {
    display: flex;
    gap: 10px;
  }

  .newsletter-c__input {
    flex: 1;
    min-width: 0;
    height: var(--input-height);
    padding: 0 18px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-input);
    background: var(--surface-soft);
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--color-ink);
    outline: none;
    transition: var(--transition-color), box-shadow var(--duration-fast) var(--ease-standard);
  }

  .newsletter-c__input::placeholder {
    color: var(--text-disabled);
  }

  .newsletter-c__input:focus {
    border-color: var(--color-slate);
    background: var(--color-canvas);
    box-shadow: var(--shadow-focus);
  }

  .newsletter-c__input--error {
    border-color: var(--color-error);
    background: var(--color-canvas);
  }

  .newsletter-c__submit {
    flex: none;
    min-height: var(--input-height);
    padding: 0 28px;
  }

  .newsletter-c__error {
    margin: 7px 0 0;
    font-family: var(--font-sans);
    font-size: var(--type-caption-sm-size);
    line-height: 1.4;
    color: var(--color-error);
  }

  .newsletter-c__success {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0 16px;
    height: var(--input-height);
    border: 1px solid var(--color-success);
    border-radius: var(--radius-input);
    background: var(--color-canvas);
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink);
  }

  .newsletter-c__success svg {
    flex: none;
    color: var(--color-success);
  }

  .newsletter-c__disclaimer {
    margin: 12px 0 0;
    font-family: var(--font-sans);
    font-size: var(--type-caption-sm-size);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .newsletter-c__disclaimer a {
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-default);
  }

  @media screen and (max-width: 749px) {
    .newsletter-c__card {
      padding: 28px 22px;
    }

    .newsletter-c__heading {
      font-size: 24px;
    }

    .newsletter-c__text {
      font-size: 15px;
    }

    .newsletter-c__row {
      flex-direction: column;
    }

    .newsletter-c__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter card",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Soft Rounds community" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Receive product updates, new releases and practical comfort tips." },
    { "type": "text", "id": "label", "label": "Field label", "default": "Email address" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "you@example.com.au" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're on the list." },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>By subscribing you agree to our Privacy Policy. Unsubscribe at any time.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 88 }
  ],
  "presets": [{ "name": "Newsletter card" }]
}
{% endschema %}
