{%- comment -%}
  Navy utility bar that sits above the header.

  Left: short reassurance messages, each with an icon. Right: the currency
  selector when localisation is enabled, and an account link.

  Icons render as CSS masks so a single SVG inherits currentColor. Set the icon
  by filename in the block settings; the file must exist in assets/.

  The cart stays in the header rather than moving here, because Dawn's header
  cart icon is what opens the cart drawer. Moving it would break that.
{%- endcomment -%}

<div class="utility-bar">
  <div class="utility-bar__inner">
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        <span class="utility-bar__item utility-bar__message" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span
              class="sr-icon utility-bar__icon"
              style="--sr-icon: url({{ block.settings.icon | asset_url }})"
              aria-hidden="true"
            ></span>
          {%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endif -%}
    {%- endfor -%}

    <span class="utility-bar__spacer"></span>

    {%- if section.settings.show_currency -%}
      {%- if localization.available_countries.size > 1 -%}
        <localization-form class="utility-bar__localization">
          {%- form 'localization', id: 'UtilityCurrencyForm', class: 'utility-bar__form' -%}
            <button
              type="button"
              class="utility-bar__item utility-bar__button"
              aria-expanded="false"
              aria-controls="UtilityCurrencyList"
              aria-describedby="UtilityCurrencyLabel"
            >
              {{ localization.country.currency.iso_code }}
              {{ localization.country.currency.symbol }}
              <span
                class="sr-icon utility-bar__caret"
                style="--sr-icon: url({{ 'icon-caret.svg' | asset_url }})"
                aria-hidden="true"
              ></span>
            </button>
            <div class="disclosure__list-wrapper" hidden>
              <ul id="UtilityCurrencyList" role="list" class="disclosure__list list-unstyled">
                {%- for country in localization.available_countries -%}
                  <li class="disclosure__item">
                    <a
                      class="link"
                      href="#"
                      {% if country.iso_code == localization.country.iso_code %}
                        aria-current="true"
                      {% endif %}
                      data-value="{{ country.iso_code }}"
                    >
                      {{ country.currency.iso_code }} {{ country.currency.symbol }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
          {%- endform -%}
        </localization-form>
      {%- else -%}
        <span class="utility-bar__item">
          {{ cart.currency.iso_code }} {{ cart.currency.symbol }}
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
      <a
        href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
        class="utility-bar__item utility-bar__link"
      >
        <span
          class="sr-icon utility-bar__icon"
          style="--sr-icon: url({{ 'icon-account.svg' | asset_url }})"
          aria-hidden="true"
        ></span>
        {{ section.settings.account_label | default: 'Account' }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .utility-bar {
    background: var(--color-navy);
    color: var(--color-on-navy-soft);
  }

  .utility-bar__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
    min-height: var(--utility-height);
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .utility-bar__item {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-sans);
    font-size: var(--type-utility-size);
    font-weight: var(--type-utility-weight);
    line-height: var(--type-utility-line);
    letter-spacing: var(--type-utility-tracking);
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .utility-bar__icon {
    width: 15px;
    height: 15px;
  }

  .utility-bar__caret {
    width: 12px;
    height: 12px;
  }

  .utility-bar__spacer {
    flex: 1;
  }

  .utility-bar__link:hover {
    color: var(--color-sage);
  }

  .utility-bar__button {
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    gap: 6px;
  }

  .utility-bar__localization {
    position: relative;
  }

  .utility-bar__localization .disclosure__list-wrapper {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 40;
  }

  /* The reassurance messages are the first to go when space runs out; the
     currency and account links matter more on a small screen. */
  @media screen and (max-width: 749px) {
    .utility-bar__inner {
      gap: 16px;
      justify-content: center;
    }

    .utility-bar__message {
      display: none;
    }

    .utility-bar__spacer {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Utility bar",
  "tag": "div",
  "class": "utility-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Account"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Shipping, returns and delivery claims must be accurate."
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon filename",
          "info": "A file in assets/, for example icon-truck.svg",
          "default": "icon-truck.svg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Utility bar",
      "blocks": [{ "type": "message" }, { "type": "message" }]
    }
  ]
}
{% endschema %}
