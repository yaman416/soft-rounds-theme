{%- comment -%}
  Cloud footer: dark band, light cloud logo, link columns from Shopify menus,
  round social buttons, and a legal bar.
{%- endcomment -%}

{%- liquid
  # Every URL already linked from the footer columns. The legal bar uses this
  # to avoid listing a policy twice when a merchant also keeps it in a menu.
  assign column_urls = ''
  for block in section.blocks
    if block.settings.menu != blank
      for link in block.settings.menu.links
        assign column_urls = column_urls | append: link.url | append: ' '
      endfor
    endif
  endfor
-%}

<footer class="cloud-foot">
  <div class="cloud-foot__inner">
    <div class="cloud-foot__brand">
      <img
        src="{{ 'logo-cloud-light.png' | asset_img_url: '400x' }}"
        alt="{{ shop.name | escape }}"
        class="cloud-foot__logo"
        width="400"
        height="205"
        loading="lazy"
      >
      {%- if section.settings.blurb != blank -%}
        <p class="cloud-foot__blurb">{{ section.settings.blurb }}</p>
      {%- endif -%}

      <div class="cloud-foot__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="cloud-foot__social-btn" aria-label="Instagram">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-instagram.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="cloud-foot__social-btn" aria-label="Facebook">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-facebook.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="cloud-foot__social-btn" aria-label="TikTok">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-tiktok.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="cloud-foot__col" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h4 class="cloud-foot__col-head">{{ block.settings.heading }}</h4>
        {%- endif -%}
        {%- if block.settings.menu != blank -%}
          <div class="cloud-foot__links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="cloud-foot__legal-wrap">
    <div class="cloud-foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      {%- comment -%}
        With no legal menu set, the bar builds itself from the store's own
        policies. Shopify exposes whichever ones are published, so this needs
        no menu to maintain and cannot fall out of sync with the policies
        themselves. Setting a legal menu overrides it.

        Policies already linked from a footer column are skipped, so each one
        appears exactly once however the merchant arranges their menus. Move a
        policy out of a column and it reappears down here on its own.
      {%- endcomment -%}
      {%- capture legal_links -%}
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy.url != blank -%}
              {%- unless column_urls contains policy.url -%}
                <a href="{{ policy.url }}">{{ policy.title }}</a>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if legal_links != blank -%}
        <div class="cloud-foot__legal-links">{{ legal_links }}</div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .cloud-foot {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.78);
  }

  .cloud-foot__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: clamp(36px, 4vw, 60px) var(--gutter-page) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: clamp(20px, 3vw, 44px);
  }

  /* The brand block takes the full width on a phone; the two link columns
     then sit side by side beneath it. At 190px they each claimed a whole row
     and left most of it empty. */
  @media screen and (max-width: 749px) {
    .cloud-foot__brand {
      grid-column: 1 / -1;
    }
  }

  .cloud-foot__logo {
    height: var(--logo-height);
    width: auto;
    display: block;
  }

  .cloud-foot__blurb {
    margin-top: 14px;
    max-width: 26ch;
    font-size: var(--type-body-xs-size);
    line-height: 1.6;
  }

  .cloud-foot__social {
    margin-top: 20px;
    display: flex;
    gap: 10px;
  }

  .cloud-foot__social-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    color: var(--color-on-dark);
    transition: var(--transition-color);
  }

  .cloud-foot__social-btn:hover {
    background: var(--color-blue);
    color: var(--color-on-dark);
  }

  .cloud-foot__social-btn .sr-icon {
    width: 19px;
    height: 19px;
  }

  .cloud-foot__col-head {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: var(--weight-bold);
    color: var(--color-on-dark);
  }

  /* Links are 44px tall rather than 23px. On a phone these are the main way
     out of the footer, and a 23px target between two others is easy to miss.
     The row gap shrinks to compensate, so the footer is barely taller. */
  .cloud-foot__links {
    margin-top: 8px;
    display: grid;
    gap: 0;
    font-size: var(--type-body-xs-size);
  }

  .cloud-foot__links a {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .cloud-foot__links a:hover {
    color: var(--color-sky);
  }

  .cloud-foot__legal-wrap {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
  }

  .cloud-foot__legal {
    margin-top: clamp(28px, 4vw, 44px);
    padding: 20px 0 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
  }

  /* Wraps because a real store menu can carry more legal links than the two
     in the design. Without this the row forces the page to scroll sideways. */
  /* A grid, not a wrapping flex row. With eight links the flex version broke
     into three rows starting at 16, 87 and 236px, which read as misaligned.
     Equal columns keep them lined up however many the merchant adds. */
  .cloud-foot__legal-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: 0 20px;
    min-width: 0;
  }

  .cloud-foot__legal-links a {
    min-height: 44px;
    display: flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cloud footer",
  "settings": [
    { "type": "text", "id": "blurb", "label": "Blurb", "default": "Premium comfort made for long shifts." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Leave empty to list the store's published policies automatically." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
