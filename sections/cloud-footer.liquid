{%- comment -%}
  Cloud footer: dark band, light cloud logo, link columns from Shopify menus,
  round social buttons, and a legal bar.
{%- endcomment -%}

<footer class="cloud-foot">
  <div class="cloud-foot__inner">
    <div class="cloud-foot__brand">
      <img
        src="{{ 'logo-cloud-light.png' | asset_img_url: '400x' }}"
        alt="{{ shop.name | escape }}"
        class="cloud-foot__logo"
        width="400"
        height="205"
        loading="lazy"
      >
      {%- if section.settings.blurb != blank -%}
        <p class="cloud-foot__blurb">{{ section.settings.blurb }}</p>
      {%- endif -%}

      <div class="cloud-foot__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="cloud-foot__social-btn" aria-label="Instagram">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-instagram.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="cloud-foot__social-btn" aria-label="Facebook">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-facebook.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="cloud-foot__social-btn" aria-label="TikTok">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-tiktok.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="cloud-foot__col" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h4 class="cloud-foot__col-head">{{ block.settings.heading }}</h4>
        {%- endif -%}
        {%- if block.settings.menu != blank -%}
          <div class="cloud-foot__links">
            {%- for link in block.settings.menu.links -%}
              {%- assign link_title_check = link.title | downcase -%}
              {%- if link_title_check contains 'coming soon' -%}
                <span class="cloud-foot__link--soon" aria-disabled="true">{{ link.title }}</span>
              {%- else -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="cloud-foot__legal-wrap">
    {%- comment -%}
      Secondary links sit in one row above the copyright, and are exactly the
      chosen menu. Policies are reachable from that menu, so nothing is added
      automatically: a link the merchant removes has to stay removed.
    {%- endcomment -%}
    {%- capture utility_links -%}
      {%- if section.settings.utility_menu != blank -%}
        {%- for link in section.settings.utility_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if utility_links != blank -%}
      <div class="cloud-foot__utility">{{ utility_links }}</div>
    {%- endif -%}

    <div class="cloud-foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="cloud-foot__pay">
        <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'cloud-foot__pay-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</footer>

{%- if section.settings.show_back_to_top -%}
  <button
    type="button"
    class="cloud-top"
    data-cloud-top
    aria-label="{{ 'accessibility.skip_to_text' | t | default: 'Back to top' }}"
  >
    <span class="sr-icon" style="--sr-icon: url({{ 'icon-caret.svg' | asset_url }})" aria-hidden="true"></span>
  </button>
{%- endif -%}

{% stylesheet %}
  .cloud-foot {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.78);
  }

  .cloud-foot__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: clamp(20px, 3vw, 44px);
  }

  /* On a phone the brand block and the link column sit side by side, so the
     links run up the right of the logo rather than starting a new row. The
     column heading is hidden there: with one column beside the logo it only
     repeats what the links already say. */
  @media screen and (max-width: 749px) {
    .cloud-foot__col-head {
      display: none;
    }

    .cloud-foot__links {
      margin-top: 0;
    }

  }

  .cloud-foot__logo {
    height: var(--logo-height);
    width: auto;
    display: block;
  }

  .cloud-foot__blurb {
    margin-top: 14px;
    max-width: 26ch;
    font-size: var(--type-body-xs-size);
    line-height: 1.6;
  }

  .cloud-foot__social {
    margin-top: 20px;
    display: flex;
    gap: 10px;
  }

  .cloud-foot__social-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    color: var(--color-on-dark);
    transition: var(--transition-color);
  }

  .cloud-foot__social-btn:hover {
    background: var(--color-blue);
    color: var(--color-on-dark);
  }

  .cloud-foot__social-btn .sr-icon {
    width: 19px;
    height: 19px;
  }

  .cloud-foot__col-head {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: var(--weight-bold);
    color: var(--color-on-dark);
  }

  /* Links are 44px tall rather than 23px. On a phone these are the main way
     out of the footer, and a 23px target between two others is easy to miss.
     The row gap shrinks to compensate, so the footer is barely taller. */
  .cloud-foot__links {
    margin-top: 8px;
    display: grid;
    gap: 0;
    font-size: var(--type-body-xs-size);
  }

  /* Matches the link box so the column keeps its rhythm, but is not a link. */
  .cloud-foot__link--soon {
    min-height: 44px;
    display: flex;
    align-items: center;
    opacity: 0.55;
    cursor: default;
  }

  .cloud-foot__links a {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .cloud-foot__links a:hover {
    color: var(--color-sky);
  }

  .cloud-foot__legal-wrap {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
  }

  /* Secondary links in a single row above the copyright, with the divider
     above them. Smaller than the column links because this is a utility row,
     not primary navigation, but each target is still 44px tall. */
  /* The bottom bar is centred as a unit at every width: the links row, the
     copyright and the payment marks. Centring only the links would leave the
     two lines under them hanging to the left. */
  .cloud-foot__utility {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 18px;
    font-size: 12.5px;
  }

  .cloud-foot__utility a {
    min-height: 44px;
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.78);
  }

  .cloud-foot__utility a:hover {
    color: var(--color-on-dark);
  }

  .cloud-foot__legal {
    padding: 4px 0 16px;
    font-size: 12.5px;
    text-align: center;
    color: rgba(255, 255, 255, 0.62);
  }

  /* Payment marks come from Shopify, so they always match what the store
     actually accepts at checkout. They are artwork, not links. */
  .cloud-foot__pay {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-bottom: clamp(28px, 4vw, 40px);
  }

  /* Floating back to top. Sits below the header's z-index so a sticky header
     always wins, and clear of the payment row at the very bottom. */
  .cloud-top {
    position: fixed;
    right: clamp(12px, 3vw, 24px);
    bottom: clamp(12px, 3vw, 24px);
    z-index: 35;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-on-dark);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow-menu);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard),
      visibility var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
  }

  .cloud-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .cloud-top:hover {
    background: var(--color-secondary);
  }

  /* The caret points down by default. */
  .cloud-top .sr-icon {
    width: 20px;
    height: 20px;
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-top {
      transition: none;
    }
  }

  .cloud-foot__pay-icon {
    height: 24px;
    width: auto;
    display: block;
    border-radius: 4px;
  }

  @media screen and (max-width: 560px) {
    .cloud-foot__utility {
      gap: 0 14px;
      font-size: 12px;
    }

    .cloud-foot__pay-icon {
      height: 22px;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Back to top. Appears once the customer is a screen or so down the page,
  // so it never covers content near the top where it would not be wanted.
  //
  // Visibility is a single class toggle. An earlier version moved the hidden
  // attribute in and out and restored it on transitionend, which made the
  // button's state depend on a transition firing and completing; that is
  // fragile and was the part hardest to prove.
  (function () {
    const button = document.querySelector('[data-cloud-top]');
    if (!button) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const update = () => {
      button.classList.toggle('is-visible', window.scrollY > window.innerHeight);
    };

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
      // Focus something at the top rather than leaving it on a control that
      // is about to fade out.
      const target = document.querySelector('.cloud-head__logo-link');
      if (target) target.focus({ preventScroll: true });
    });

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Cloud footer",
  "settings": [
    { "type": "text", "id": "blurb", "label": "Blurb", "default": "Premium comfort made for long shifts." },
    { "type": "link_list", "id": "utility_menu", "label": "Secondary links row", "info": "Shown as one small row above the copyright. Add your policy links here." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back to top button", "default": true }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
