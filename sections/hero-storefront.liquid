{%- comment -%}
  Navy-generation hero: copy on a sand band at the left, a full-bleed
  photograph at the right carrying a sage roundel.

  Two honesty guards are built in:
  - The rating row is empty by default. The design file's own pre-launch notes
    say the "4.9 from 1,200+ reviews" figure was taken from a reference mockup
    and must be wired to a real review platform or removed.
  - The roundel figure is blank by default. Compression may be described as a
    support level only, and the number must match the supplier spec sheet.
{%- endcomment -%}

{%- liquid
  assign hero_image = section.settings.image
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="hero-n section-{{ section.id }}-padding">
  <div class="hero-n__grid">
    <div class="hero-n__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sr-eyebrow hero-n__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="hero-n__heading">{{ section.settings.heading }}</h1>

      {%- if section.settings.text != blank -%}
        <p class="hero-n__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="hero-n__cta">
          {{ section.settings.button_label }}
          <span class="hero-n__cta-circle" aria-hidden="true">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-arrow.svg' | asset_url }})"></span>
          </span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Only renders when the merchant has supplied a genuine, sourced rating.
      {%- endcomment -%}
      {%- if section.settings.rating_score != blank and section.settings.rating_source != blank -%}
        <div class="hero-n__rating">
          {%- if section.settings.rating_word != blank -%}
            <span class="hero-n__rating-word">{{ section.settings.rating_word }}</span>
          {%- endif -%}
          <span class="hero-n__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <span class="hero-n__star">
                <span class="sr-icon" style="--sr-icon: url({{ 'icon-star-solid.svg' | asset_url }})"></span>
              </span>
            {%- endfor -%}
          </span>
          <span class="hero-n__rating-text">{{ section.settings.rating_score }}</span>
          <span class="hero-n__rating-source">{{ section.settings.rating_source }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="hero-n__media">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 1800
          | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading, sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {%- else -%}
        <img
          src="{{ 'sr-nurse-locker-room.webp' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1800"
          height="1400"
        >
      {%- endif -%}

      {%- if section.settings.roundel_figure != blank -%}
        <div class="hero-n__roundel">
          <div>
            {%- if section.settings.roundel_label != blank -%}
              <div class="hero-n__roundel-label">{{ section.settings.roundel_label }}</div>
            {%- endif -%}
            <div class="hero-n__roundel-figure">{{ section.settings.roundel_figure }}</div>
            {%- if section.settings.roundel_unit != blank -%}
              <div class="hero-n__roundel-unit">{{ section.settings.roundel_unit }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-n {
    background: var(--color-sand);
  }

  .hero-n__grid {
    max-width: var(--container-page);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    align-items: stretch;
  }

  .hero-n__copy {
    padding: clamp(32px, 4vw, 64px) var(--gutter-page);
    align-self: center;
  }

  .hero-n__eyebrow {
    margin: 0;
    font-size: 12px;
  }

  .hero-n__heading {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4.8vw, 58px);
    font-weight: var(--weight-bold);
    line-height: 1.04;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .hero-n__text {
    margin: 22px 0 0;
    max-width: 42ch;
    font-family: var(--font-sans);
    font-size: var(--type-body-md-size);
    line-height: var(--type-body-md-line);
    color: var(--color-body);
    text-wrap: pretty;
  }

  /* The CTA carries a circled arrow rather than a plain label. */
  .hero-n__cta {
    margin: 30px 0 0;
    height: var(--button-height-secondary);
    padding: 0 10px 0 26px;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    border-radius: var(--radius-button);
    background: var(--color-navy);
    color: var(--color-on-navy);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--transition-color);
  }

  .hero-n__cta:hover {
    background: var(--color-navy-hover);
    color: var(--color-on-navy);
  }

  .hero-n__cta-circle {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background: rgba(251, 246, 242, 0.14);
    display: grid;
    place-items: center;
  }

  .hero-n__cta-circle .sr-icon {
    width: 16px;
    height: 16px;
  }

  .hero-n__rating {
    margin: 30px 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-n__rating-word,
  .hero-n__rating-source {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
  }

  .hero-n__rating-text {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--color-body);
  }

  .hero-n__stars {
    display: flex;
    gap: 2px;
  }

  .hero-n__star {
    width: 19px;
    height: 19px;
    display: grid;
    place-items: center;
    background: var(--color-sage-text);
    color: var(--color-on-navy);
  }

  .hero-n__star .sr-icon {
    width: 12px;
    height: 12px;
  }

  .hero-n__media {
    position: relative;
    min-height: 420px;
    background: var(--surface-photo);
  }

  .hero-n__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-n__roundel {
    position: absolute;
    right: clamp(16px, 3vw, 40px);
    bottom: 56px;
    width: 124px;
    height: 124px;
    border-radius: var(--radius-full);
    background: var(--color-sage);
    color: var(--color-navy);
    display: grid;
    place-items: center;
    text-align: center;
    padding: 12px;
  }

  .hero-n__roundel-label {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-n__roundel-figure {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
  }

  .hero-n__roundel-unit {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--weight-medium);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (storefront)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compression socks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium comfort made for long shifts" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Describe comfort and support. Do not imply diagnosis, prevention or treatment." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop compression socks" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, falls back to bundled photo)" },
    {
      "type": "header",
      "content": "Roundel"
    },
    { "type": "text", "id": "roundel_label", "label": "Roundel label", "default": "Graduated compression" },
    { "type": "text", "id": "roundel_figure", "label": "Roundel figure", "info": "Leave blank until the supplier spec sheet is confirmed. Describe a support level only, for example 15-20." },
    { "type": "text", "id": "roundel_unit", "label": "Roundel unit", "default": "mmHg" },
    {
      "type": "header",
      "content": "Rating"
    },
    { "type": "text", "id": "rating_word", "label": "Rating word", "info": "For example: Excellent" },
    { "type": "text", "id": "rating_score", "label": "Rating summary", "info": "Only fill this in with a genuine figure from a real review platform. Invented ratings breach the brand's content rules and Australian Consumer Law." },
    { "type": "text", "id": "rating_source", "label": "Review platform name", "info": "Required before the rating row will display." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [{ "name": "Hero (storefront)" }]
}
{% endschema %}
