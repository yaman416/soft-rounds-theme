{%- comment -%}
  Cloud footer: dark band, light cloud logo, link columns from Shopify menus,
  round social buttons, and a legal bar.
{%- endcomment -%}

<footer class="cloud-foot">
  <div class="cloud-foot__inner">
    <div class="cloud-foot__brand">
      <img
        src="{{ 'logo-cloud-light.png' | asset_img_url: '400x' }}"
        alt="{{ shop.name | escape }}"
        class="cloud-foot__logo"
        width="400"
        height="205"
        loading="lazy"
      >
      {%- if section.settings.blurb != blank -%}
        <p class="cloud-foot__blurb">{{ section.settings.blurb }}</p>
      {%- endif -%}

      <div class="cloud-foot__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="cloud-foot__social-btn" aria-label="Instagram">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-instagram.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="cloud-foot__social-btn" aria-label="Facebook">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-facebook.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="cloud-foot__social-btn" aria-label="TikTok">
            <span class="sr-icon" style="--sr-icon: url({{ 'icon-tiktok.svg' | asset_url }})" aria-hidden="true"></span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="cloud-foot__col" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h4 class="cloud-foot__col-head">{{ block.settings.heading }}</h4>
        {%- endif -%}
        {%- if block.settings.menu != blank -%}
          <div class="cloud-foot__links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="cloud-foot__legal-wrap">
    {%- comment -%}
      Secondary links sit in one row above the copyright, and are exactly the
      chosen menu. Policies are reachable from that menu, so nothing is added
      automatically: a link the merchant removes has to stay removed.
    {%- endcomment -%}
    {%- capture utility_links -%}
      {%- if section.settings.utility_menu != blank -%}
        {%- for link in section.settings.utility_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if utility_links != blank -%}
      <div class="cloud-foot__utility">{{ utility_links }}</div>
    {%- endif -%}

    <div class="cloud-foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="cloud-foot__pay">
        <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'cloud-foot__pay-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</footer>

{% stylesheet %}
  .cloud-foot {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.78);
  }

  .cloud-foot__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: clamp(36px, 4vw, 60px) var(--gutter-page) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: clamp(20px, 3vw, 44px);
  }

  /* On a phone the brand block and the link column sit side by side, so the
     links run up the right of the logo rather than starting a new row. The
     column heading is hidden there: with one column beside the logo it only
     repeats what the links already say. */
  @media screen and (max-width: 749px) {
    .cloud-foot__col-head {
      display: none;
    }

    .cloud-foot__links {
      margin-top: 0;
    }

    .cloud-foot__legal,
    .cloud-foot__pay {
      justify-content: center;
      text-align: center;
    }

    .cloud-foot__pay {
      justify-content: center;
    }
  }

  .cloud-foot__logo {
    height: var(--logo-height);
    width: auto;
    display: block;
  }

  .cloud-foot__blurb {
    margin-top: 14px;
    max-width: 26ch;
    font-size: var(--type-body-xs-size);
    line-height: 1.6;
  }

  .cloud-foot__social {
    margin-top: 20px;
    display: flex;
    gap: 10px;
  }

  .cloud-foot__social-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    color: var(--color-on-dark);
    transition: var(--transition-color);
  }

  .cloud-foot__social-btn:hover {
    background: var(--color-blue);
    color: var(--color-on-dark);
  }

  .cloud-foot__social-btn .sr-icon {
    width: 19px;
    height: 19px;
  }

  .cloud-foot__col-head {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: var(--weight-bold);
    color: var(--color-on-dark);
  }

  /* Links are 44px tall rather than 23px. On a phone these are the main way
     out of the footer, and a 23px target between two others is easy to miss.
     The row gap shrinks to compensate, so the footer is barely taller. */
  .cloud-foot__links {
    margin-top: 8px;
    display: grid;
    gap: 0;
    font-size: var(--type-body-xs-size);
  }

  .cloud-foot__links a {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .cloud-foot__links a:hover {
    color: var(--color-sky);
  }

  .cloud-foot__legal-wrap {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
  }

  /* Secondary links in a single row above the copyright, with the divider
     above them. Smaller than the column links because this is a utility row,
     not primary navigation, but each target is still 44px tall. */
  .cloud-foot__utility {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    font-size: 12.5px;
  }

  .cloud-foot__utility a {
    min-height: 44px;
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.78);
  }

  .cloud-foot__utility a:hover {
    color: var(--color-on-dark);
  }

  .cloud-foot__legal {
    padding: 4px 0 16px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.62);
  }

  /* Payment marks come from Shopify, so they always match what the store
     actually accepts at checkout. They are artwork, not links. */
  .cloud-foot__pay {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-bottom: clamp(28px, 4vw, 40px);
  }

  .cloud-foot__pay-icon {
    height: 24px;
    width: auto;
    display: block;
    border-radius: 4px;
  }

  @media screen and (max-width: 560px) {
    .cloud-foot__utility {
      gap: 0 14px;
      font-size: 12px;
    }

    .cloud-foot__pay-icon {
      height: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cloud footer",
  "settings": [
    { "type": "text", "id": "blurb", "label": "Blurb", "default": "Premium comfort made for long shifts." },
    { "type": "link_list", "id": "utility_menu", "label": "Secondary links row", "info": "Shown as one small row above the copyright. Add your policy links here." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
