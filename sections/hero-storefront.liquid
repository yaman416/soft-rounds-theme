{%- liquid
  assign hero_image = section.settings.image
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="hero-storefront color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="hero-storefront__inner sr-container">
    <div class="hero-storefront__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sr-badge sr-badge--soft">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="hero-storefront__heading">{{ section.settings.heading }}</h1>
      <p class="hero-storefront__text">{{ section.settings.text }}</p>

      <div class="hero-storefront__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="sr-btn sr-btn--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="sr-btn sr-btn--secondary">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero-storefront__specs" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign tints = 'sage,cream,blush' | split: ','
              assign tint = tints[forloop.index0] | default: 'cream'
            -%}
            <li class="sr-spec sr-spec--{{ tint }}" {{ block.shopify_attributes }}>
              <span class="sr-spec__icon">{{ block.settings.icon | inline_asset_content }}</span>
              <span class="sr-spec__label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero-storefront__media">
      <div class="sr-photo hero-storefront__plate">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1400
            | image_tag: loading: 'eager', alt: section.settings.heading, sizes: '(min-width: 1080px) 50vw, 100vw'
          }}
        {%- else -%}
          <img
            src="{{ 'sr-nurse-locker-room.webp' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="1400"
            height="1050"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-storefront__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xxl);
    align-items: center;
  }

  .hero-storefront__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-base);
  }

  .hero-storefront__heading {
    font-family: var(--font-display);
    font-size: var(--type-hero-size);
    font-weight: var(--type-hero-weight);
    line-height: var(--type-hero-line);
    letter-spacing: var(--type-hero-tracking);
    color: var(--color-ink);
    margin: 0;
  }

  .hero-storefront__text {
    font-family: var(--font-sans);
    font-size: var(--type-body-md-size);
    line-height: var(--type-body-md-line);
    color: var(--text-body);
    max-width: 44rem;
    text-wrap: pretty;
    margin: 0;
  }

  .hero-storefront__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero-storefront__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .hero-storefront__plate {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
  }

  @media screen and (max-width: 1080px) {
    .hero-storefront__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .hero-storefront__heading {
      font-size: var(--type-display-xl-size);
      letter-spacing: var(--type-display-xl-tracking);
    }

    .hero-storefront__specs {
      gap: var(--space-lg);
    }
  }

  @media screen and (max-width: 744px) {
    .hero-storefront__specs {
      gap: var(--space-base) var(--space-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (storefront)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "info": "Product claims here must be verifiable." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort for every shift." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, falls back to bundled photo)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec chip",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon filename", "info": "e.g. icon-leaf.svg", "default": "icon-leaf.svg" },
        { "type": "text", "id": "label", "label": "Label", "info": "Material and performance claims must be verifiable." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (storefront)",
      "blocks": [
        { "type": "spec", "settings": { "icon": "icon-leaf.svg", "label": "Bamboo blend" } },
        { "type": "spec", "settings": { "icon": "icon-wind.svg", "label": "Breathable" } },
        { "type": "spec", "settings": { "icon": "icon-heart.svg", "label": "All-day support" } }
      ]
    }
  ]
}
{% endschema %}
