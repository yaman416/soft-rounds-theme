{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="scrubs-teaser section-{{ section.id }}-padding">
  <div class="sr-container">
    <div class="scrubs-teaser__frame">
      <div class="sr-photo scrubs-teaser__plate">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: loading: 'lazy', alt: section.settings.heading, sizes: '100vw'
          }}
        {%- else -%}
          <img
            src="{{ 'sr-scrubs-duo.webp' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1400"
            height="600"
          >
        {%- endif -%}
      </div>

      <span class="scrubs-teaser__scrim" aria-hidden="true"></span>

      <div class="scrubs-teaser__body">
        {%- if section.settings.badge != blank -%}
          <span class="sr-badge sr-badge--cream sr-badge--float">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 class="scrubs-teaser__heading">{{ section.settings.heading }}</h2>
        <p class="scrubs-teaser__text">{{ section.settings.text }}</p>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="sr-btn sr-btn--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .scrubs-teaser__frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .scrubs-teaser__plate {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-xl);
  }

  .scrubs-teaser__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(34, 34, 34, 0.72) 0%,
      rgba(34, 34, 34, 0.25) 55%,
      rgba(34, 34, 34, 0) 100%
    );
  }

  .scrubs-teaser__body {
    position: absolute;
    left: 6%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    color: #fff;
  }

  .scrubs-teaser__heading {
    font-family: var(--font-display);
    font-size: var(--type-display-xl-size);
    font-weight: var(--type-display-xl-weight);
    line-height: var(--type-display-xl-line);
    letter-spacing: var(--type-display-xl-tracking);
    color: #fff;
    margin: 0;
  }

  .scrubs-teaser__text {
    font-family: var(--font-sans);
    font-size: var(--type-body-md-size);
    line-height: var(--type-body-md-line);
    opacity: 0.92;
    text-wrap: pretty;
    margin: 0;
  }

  @media screen and (max-width: 1080px) {
    .scrubs-teaser__plate {
      aspect-ratio: 16 / 10;
    }

    .scrubs-teaser__heading {
      font-size: var(--type-display-lg-size);
    }
  }

  @media screen and (max-width: 744px) {
    .scrubs-teaser__frame {
      border-radius: var(--radius-lg);
    }

    .scrubs-teaser__plate {
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-lg);
    }

    .scrubs-teaser__scrim {
      background: linear-gradient(
        to top,
        rgba(34, 34, 34, 0.82) 0%,
        rgba(34, 34, 34, 0.35) 55%,
        rgba(34, 34, 34, 0.05) 100%
      );
    }

    .scrubs-teaser__body {
      left: var(--space-lg);
      right: var(--space-lg);
      top: auto;
      bottom: var(--space-lg);
      transform: none;
      max-width: none;
    }

    .scrubs-teaser__heading {
      font-size: var(--type-display-md-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scrubs teaser",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scrubs, sold as separates." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Fabric, fit and sizing claims must match the actual product." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop scrubs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, falls back to bundled photo)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "Scrubs teaser" }]
}
{% endschema %}
