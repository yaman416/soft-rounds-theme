{%- comment -%}
  Cloud header: a floating white pill on a translucent page-coloured strip,
  sticky to the top. Below 940px the inline nav is replaced by a round menu
  button that opens a rounded panel underneath.

  This replaces Dawn's header entirely rather than overriding it, because the
  pill shape, the labelled cart and the panel menu are structurally different
  from anything Dawn renders.

  Cart and search stay wired to Dawn's own drawer and search modal so the
  commerce behaviour is unchanged.
{%- endcomment -%}

<div class="cloud-head">
  <div class="cloud-head__panel">
    <a href="{{ routes.root_url }}" class="cloud-head__logo-link">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: class: 'cloud-head__logo', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'logo-cloud-dark.png' | asset_img_url: '400x' }}"
          class="cloud-head__logo"
          alt="{{ shop.name | escape }}"
          width="400"
          height="205"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- if section.settings.menu != blank -%}
      <nav class="cloud-head__nav">
        {%- comment -%}
          A menu item whose title says "coming soon" renders as plain text, not
          a link. Shopify menus carry no per-item settings, so the title is the
          only place a merchant can mark one, and a link to an empty collection
          is worse than a label that says it is not ready.
        {%- endcomment -%}
        {%- for link in section.settings.menu.links -%}
          {%- assign link_title_check = link.title | downcase -%}
          {%- if link_title_check contains 'coming soon' -%}
            <span class="cloud-head__link cloud-head__link--soon" aria-disabled="true">
              {{- link.title -}}
            </span>
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="cloud-head__link{% if link.active %} cloud-head__link--active{% endif %}"
            >
              {{- link.title -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="cloud-head__actions">
      {%- comment -%}
        header-search renders the whole modal: its own details, summary and
        dialog. Wrapping it in a second details-modal produced two summaries,
        so two close icons appeared and the input collapsed to 72px inside the
        nested dialog. Render it plain and restyle its summary below.
      {%- endcomment -%}
      {%- render 'header-search', input_id: 'Search-In-Cloud-Modal' -%}

      <a href="{{ routes.cart_url }}" class="cloud-head__cart">
        <span class="sr-icon" style="--sr-icon: url({{ 'icon-cart.svg' | asset_url }})" aria-hidden="true"></span>
        <span class="cloud-head__cart-label">
          {{ section.settings.cart_label | default: 'Cart' }} ({{ cart.item_count }})
        </span>
      </a>

      <button
        type="button"
        class="cloud-head__menu-btn"
        aria-expanded="false"
        aria-controls="CloudMenu"
        aria-label="Open menu"
        data-cloud-menu-toggle
      >
        <span class="sr-icon" style="--sr-icon: url({{ 'icon-plus.svg' | asset_url }})" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {%- if section.settings.menu != blank -%}
    <div class="cloud-head__menu" id="CloudMenu" hidden>
      {%- for link in section.settings.menu.links -%}
        {%- assign link_title_check = link.title | downcase -%}
        {%- if link_title_check contains 'coming soon' -%}
          <span class="cloud-head__menu-link cloud-head__menu-link--soon" aria-disabled="true">
            {{- link.title -}}
          </span>
        {%- else -%}
          <a href="{{ link.url }}" class="cloud-head__menu-link">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- comment -%}
  Dawn renders the add-to-cart notification from inside its own header
  section. This header replaces that one, so it has to carry the notification
  too. Without it, "Add to cart" succeeds silently and the customer gets no
  confirmation at all.

  The drawer variant is rendered by layout/theme.liquid, so only the
  notification needs handling here.
{%- endcomment -%}
{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% stylesheet %}
  .cloud-head {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 12px clamp(12px, 3vw, 28px);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(8px);
  }

  .cloud-head__panel {
    max-width: var(--container-page);
    margin: 0 auto;
    background: var(--color-white);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-header);
    padding: 9px clamp(12px, 2vw, 22px);
    display: flex;
    align-items: center;
    gap: clamp(8px, 2.5vw, 32px);
  }

  .cloud-head__logo-link {
    flex: none;
    display: block;
  }

  .cloud-head__logo {
    height: var(--logo-height);
    width: auto;
    display: block;
  }

  /* The nav takes the space the logo and actions do not need. It never
     wraps: a second row would break the pill. Menus longer than the pill can
     hold collapse to the menu button instead. */
  .cloud-head__nav {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .cloud-head__link {
    flex: none;
    white-space: nowrap;
    height: var(--nav-link-height);
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    transition: var(--transition-color);
  }

  /* Shown but not clickable: dimmed, no pointer, no hover response. */
  .cloud-head__link--soon,
  .cloud-head__menu-link--soon {
    opacity: 0.55;
    cursor: default;
  }

  .cloud-head__link--soon:hover,
  .cloud-head__menu-link--soon:hover {
    background: transparent;
  }

  .cloud-head__link:hover,
  .cloud-head__link--active {
    background: var(--color-mist);
    color: var(--color-ink);
  }

  /* margin-left:auto rather than relying on the nav to fill the gap. Below
     940px the nav is hidden, and without this the buttons bunch up against
     the logo with dead space to their right. */
  .cloud-head__actions {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  /* Dawn's own search trigger, dressed as the round button this header uses.
     Higher specificity than .header__icon because Dawn's stylesheets load
     after this section's. */
  .cloud-head .header__search .header__icon--search {
    width: var(--control-height);
    height: var(--control-height);
    flex: none;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-page);
    color: var(--color-ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    list-style: none;
    transition: var(--transition-color);
  }

  .cloud-head .header__search .header__icon--search:hover {
    background: var(--color-accent);
  }

  .cloud-head .header__search .header__icon--search::-webkit-details-marker {
    display: none;
  }

  .cloud-head .header__search .header__search-label {
    display: none;
  }

  .cloud-head .header__search .svg-wrapper svg {
    width: 20px;
    height: 20px;
  }

  .cloud-head__icon-btn {
    width: var(--control-height);
    height: var(--control-height);
    flex: none;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-page);
    color: var(--color-ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    list-style: none;
    transition: var(--transition-color);
  }

  .cloud-head__icon-btn::-webkit-details-marker {
    display: none;
  }

  .cloud-head__icon-btn:hover {
    background: var(--color-sky-pale);
  }

  .cloud-head__icon-btn .sr-icon {
    width: 20px;
    height: 20px;
  }

  .cloud-head__cart {
    height: var(--control-height);
    flex: none;
    padding: 0 20px 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-full);
    background: var(--color-blue);
    color: var(--color-on-dark);
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: var(--weight-semibold);
    transition: var(--transition-color);
  }

  .cloud-head__cart:hover {
    background: var(--color-blue-hover);
    color: var(--color-on-dark);
  }

  .cloud-head__cart .sr-icon {
    width: 19px;
    height: 19px;
  }

  .cloud-head__menu-btn {
    width: var(--control-height);
    height: var(--control-height);
    flex: none;
    display: none;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-on-dark);
    place-items: center;
    cursor: pointer;
  }

  .cloud-head__menu-btn .sr-icon {
    width: 20px;
    height: 20px;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .cloud-head__menu-btn[aria-expanded='true'] .sr-icon {
    transform: rotate(45deg);
  }

  .cloud-head__menu {
    max-width: var(--container-page);
    margin: 10px auto 0;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-menu);
    padding: 12px;
    display: grid;
    gap: 4px;
  }

  .cloud-head__menu[hidden] {
    display: none;
  }

  .cloud-head__menu-link {
    height: 52px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    border-radius: 20px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    transition: var(--transition-color);
  }

  .cloud-head__menu-link:hover {
    background: var(--color-mist);
    color: var(--color-ink);
  }

  /* The inline nav survives down to 800px, which covers iPad portrait. At 805
     the three current links need 289px against 325px of free space, so hiding
     them there sent tablet users through a menu button for no reason. Links
     tighten between 800 and 940 to leave room for a fourth or fifth. */
  @media screen and (min-width: 800px) and (max-width: 940px) {
    .cloud-head__link {
      padding: 0 12px;
      font-size: 14.5px;
    }
  }

  @media screen and (max-width: 799px) {
    .cloud-head__nav {
      display: none;
    }

    .cloud-head__menu-btn {
      display: grid;
    }
  }

  /* At the narrowest widths the cart collapses to its icon. */
  @media screen and (max-width: 560px) {
    .cloud-head__cart {
      padding: 0;
      width: var(--control-height);
      justify-content: center;
    }

    .cloud-head__cart-label {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Publish the header's real height so anything else that sticks (the
  // collection filter bar) can sit directly beneath it instead of sliding
  // under. The height changes with the logo size across breakpoints, so this
  // is measured rather than hardcoded.
  (function () {
    const header = document.querySelector('.cloud-head');
    if (!header) return;
    const publish = () => {
      document.documentElement.style.setProperty(
        '--cloud-header-h',
        Math.round(header.getBoundingClientRect().height) + 'px'
      );
    };
    publish();
    if (window.ResizeObserver) new ResizeObserver(publish).observe(header);
    window.addEventListener('resize', publish);
  })();

  (function () {
    const menu = document.getElementById('CloudMenu');
    const toggle = document.querySelector('[data-cloud-menu-toggle]');
    if (!menu || !toggle) return;

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open, returnFocus) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      if (open) {
        const first = menu.querySelector('a');
        if (first) first.focus();
      } else if (returnFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(!isOpen(), true));

    // Escape closes and hands focus back to the control that opened it.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false, true);
    });

    // Clicking outside closes, without stealing focus.
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (menu.contains(event.target) || toggle.contains(event.target)) return;
      setOpen(false, false);
    });

    // Keep Tab inside the panel while it is open.
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = [toggle, ...menu.querySelectorAll('a')];
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // A resize back to desktop must not leave the panel stranded open.
    window.addEventListener('resize', () => {
      if (isOpen() && window.innerWidth > 940) setOpen(false, false);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Cloud header",
  "class": "cloud-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the bundled cloud wordmark." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" }
  ]
}
{% endschema %}
