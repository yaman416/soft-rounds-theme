{%- comment -%}
  Direction C "Our story": copy on one side, a pair of overlapping images on the
  other. The smaller image carries an ivory border so it reads as sitting on top
  of the larger one rather than butting against it.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="story-c color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="sr-container">
    <div class="story-c__grid{% if section.settings.layout == 'media_first' %} story-c__grid--media-first{% endif %}">
      <div class="story-c__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="story-c__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="story-c__heading">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_accent != blank -%}
            <em class="sr-accent">{{ section.settings.heading_accent }}</em>
          {%- endif -%}
          {{- section.settings.heading_end -}}
        </h2>

        {%- if section.settings.text != blank -%}
          <p class="story-c__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="story-c__list" role="list">
            {%- for block in section.blocks -%}
              <li class="story-c__list-item" {{ block.shopify_attributes }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                {{ block.settings.label }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="sr-btn sr-btn--primary story-c__cta">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="story-c__media">
        <div class="story-c__plate story-c__plate--back">
          {%- if section.settings.image_back != blank -%}
            {{
              section.settings.image_back
              | image_url: width: 1200
              | image_tag: loading: 'lazy', alt: section.settings.heading, sizes: '(min-width: 990px) 33vw, 100vw'
            }}
          {%- elsif section.settings.fallback_image_back != blank -%}
            <img
              src="{{ section.settings.fallback_image_back | asset_url }}"
              alt=""
              loading="lazy"
              width="1200"
              height="900"
            >
          {%- endif -%}
        </div>
        <div class="story-c__plate story-c__plate--front">
          {%- if section.settings.image_front != blank -%}
            {{
              section.settings.image_front
              | image_url: width: 900
              | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 990px) 26vw, 60vw'
            }}
          {%- elsif section.settings.fallback_image_front != blank -%}
            <img
              src="{{ section.settings.fallback_image_front | asset_url }}"
              alt=""
              loading="lazy"
              width="900"
              height="700"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .story-c__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .story-c__grid--media-first .story-c__copy {
    order: 2;
  }

  .story-c__eyebrow {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 13px;
    border-radius: var(--radius-full);
    background: var(--surface-strong);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--type-badge-size);
    font-weight: var(--type-badge-weight);
    line-height: 1;
    letter-spacing: var(--type-badge-tracking);
    text-transform: uppercase;
  }

  .story-c__heading {
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-size: var(--type-display-xl-size);
    font-weight: var(--type-display-xl-weight);
    line-height: var(--type-display-xl-line);
    letter-spacing: var(--type-display-xl-tracking);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .story-c__text {
    margin: 18px 0 0;
    max-width: 480px;
    font-family: var(--font-sans);
    font-size: var(--type-body-lg-size);
    line-height: 1.65;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .story-c__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
  }

  .story-c__list-item {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .story-c__list-item svg {
    flex: none;
    color: var(--color-slate);
  }

  .story-c__cta {
    margin-top: 30px;
  }

  .story-c__media {
    position: relative;
    height: 520px;
  }

  .story-c__plate {
    position: absolute;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface-photo);
  }

  .story-c__plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-c__plate--back {
    left: 0;
    top: 0;
    width: 66%;
    height: 420px;
  }

  .story-c__plate--front {
    right: 0;
    bottom: 0;
    width: 52%;
    height: 320px;
    background: var(--color-sage);
    border: 8px solid var(--color-ivory);
    box-sizing: border-box;
  }

  @media screen and (max-width: 989px) {
    .story-c__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .story-c__grid--media-first .story-c__copy {
      order: 0;
    }

    .story-c__heading {
      margin-top: 14px;
      font-size: 26px;
      line-height: 1.2;
    }

    .story-c__text {
      font-size: 15.5px;
    }

    .story-c__media {
      height: 340px;
    }

    .story-c__plate--back {
      height: 260px;
    }

    .story-c__plate--front {
      width: 56%;
      height: 200px;
      border-width: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story split",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading — first part", "default": "Created for people who " },
    { "type": "text", "id": "heading_accent", "label": "Heading — accent phrase", "info": "Shown in the serif italic accent face. Leave blank for none.", "default": "care for others" },
    { "type": "text", "id": "heading_end", "label": "Heading — last part" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "copy_first", "label": "Copy on the left" },
        { "value": "media_first", "label": "Images on the left" }
      ],
      "default": "copy_first"
    },
    { "type": "image_picker", "id": "image_back", "label": "Large image" },
    { "type": "text", "id": "fallback_image_back", "label": "Large image — bundled filename", "info": "Used when no image is picked, e.g. sr-knit-detail-blush.webp" },
    { "type": "image_picker", "id": "image_front", "label": "Small overlapping image" },
    { "type": "text", "id": "fallback_image_front", "label": "Small image — bundled filename", "info": "e.g. sr-socks-packaging-blush.webp" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Checklist point",
      "settings": [{ "type": "text", "id": "label", "label": "Label" }]
    }
  ],
  "presets": [
    {
      "name": "Story split",
      "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }]
    }
  ]
}
{% endschema %}
