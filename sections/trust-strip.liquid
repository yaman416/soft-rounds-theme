{%- comment -%}
  Trust strip: shipping, returns, payment and support reassurance.

  Same divider mechanism as the benefits strip: a 1px grid gap over a per-cell
  right-edge box-shadow, so a wrapped row never leaves a floating rule.

  Every line here is a promise to a customer. Shipping, returns and support
  claims must match what the store actually does.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .trust-n__grid {
    --trust-min: {{ section.settings.min_column_width }}px;
  }
{%- endstyle -%}

<div class="trust-n section-{{ section.id }}-padding">
  <div class="trust-n__inner">
    <div class="trust-n__grid">
      {%- for block in section.blocks -%}
        <div class="trust-n__cell" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span
              class="sr-icon trust-n__icon"
              style="--sr-icon: url({{ block.settings.icon | asset_url }})"
              aria-hidden="true"
            ></span>
          {%- endif -%}
          <div>
            {%- if block.settings.label != blank -%}
              <div class="trust-n__label">{{ block.settings.label }}</div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="trust-n__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .trust-n__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--gutter-page);
  }

  .trust-n__grid {
    background: #fbf7f2;
    border-radius: var(--radius-card);
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--trust-min, 215px), 100%), 1fr));
    gap: 1px;
  }

  .trust-n__cell {
    background: #fbf7f2;
    box-shadow: 1px 0 0 0 var(--color-hairline);
    padding: clamp(20px, 2.4vw, 24px);
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-body);
  }

  .trust-n__icon {
    width: 26px;
    height: 26px;
  }

  .trust-n__label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .trust-n__text {
    margin-top: 4px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-body);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "min_column_width",
      "min": 160,
      "max": 320,
      "step": 5,
      "unit": "px",
      "label": "Minimum column width",
      "default": 215
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 44 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon filename",
          "info": "A file in assets/, for example icon-truck.svg",
          "default": "icon-truck.svg"
        },
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "info": "Shipping times, returns windows and support promises must match what the store actually offers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
