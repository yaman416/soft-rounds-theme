{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="category-tiles color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="sr-container">
    {%- if section.settings.title != blank -%}
      <div class="sr-section-head">
        <h2 class="sr-section-head__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="category-tiles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_soon = block.settings.coming_soon
          assign target = block.settings.link
          if is_soon and target == blank
            assign target = '#'
          endif
        -%}
        <a
          href="{{ target }}"
          class="sr-category{% if is_soon %} sr-category--soon{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="sr-photo category-tiles__plate">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: block.settings.title, sizes: '(min-width: 1080px) 50vw, 100vw'
              }}
            {%- elsif block.settings.fallback_image != blank -%}
              <img
                src="{{ block.settings.fallback_image | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="1200"
                height="900"
              >
            {%- endif -%}
          </div>

          <span class="sr-category__scrim" aria-hidden="true"></span>

          {%- if is_soon -%}
            <span class="sr-category__badge">
              <span class="sr-badge sr-badge--soon sr-badge--uppercase sr-badge--float">Coming soon</span>
            </span>
          {%- elsif block.settings.badge != blank -%}
            <span class="sr-category__badge">
              <span class="sr-badge sr-badge--cream sr-badge--float">{{ block.settings.badge }}</span>
            </span>
          {%- endif -%}

          <span class="sr-category__body">
            <span class="sr-category__title">{{ block.settings.title }}</span>
            {%- if block.settings.caption != blank -%}
              <span class="sr-category__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
            <span class="sr-category__cta">
              {%- if is_soon -%}
                {{ block.settings.soon_cta | default: 'Notify me' }}
              {%- else -%}
                {{ block.settings.cta | default: 'Shop the range' }}
              {%- endif -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .category-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .category-tiles__plate {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
  }

  .category-tiles .sr-category__title,
  .category-tiles .sr-category__caption,
  .category-tiles .sr-category__cta {
    display: block;
  }

  .category-tiles .sr-category__cta {
    width: fit-content;
  }

  @media screen and (max-width: 744px) {
    .category-tiles__grid {
      grid-template-columns: 1fr;
      gap: var(--space-base);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Two ranges" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Premium compression socks" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Bundled image filename", "info": "Used when no image is picked, e.g. sr-daisy-blush-pair-flat.webp" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop the range" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon", "default": false },
        { "type": "text", "id": "soon_cta", "label": "Coming soon CTA", "default": "Notify me" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Premium compression socks",
            "caption": "20–30 mmHg · Bamboo blend",
            "fallback_image": "sr-socks-colour-range-flatlay.webp",
            "badge": "Best seller"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Premium scrubs",
            "caption": "Four-way stretch · Sold as separates",
            "fallback_image": "sr-scrubs-duo.webp",
            "coming_soon": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
